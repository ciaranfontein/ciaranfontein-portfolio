---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../site.config";

// KiraKiran is in a closed TestFlight beta with salons (off sale on the App Store), so
// the calls to action point to the on-page beta sign-up form (#beta).
// TODO(owner-approved prod release): switch to https://zvdinfnnfcnlhuiiigkq.supabase.co/functions/v1/beta-signup
const BETA_SIGNUP_ENDPOINT = "https://tusulniayynekirfcmpv.supabase.co/functions/v1/beta-signup";
const BETA_URL = "#beta";
const BETA_FALLBACK_MAILTO = `mailto:${SITE.email}?subject=${encodeURIComponent("KiraKiranベータ版に参加したい")}`;
const title = "KiraKiran（キラキラン）｜個人ネイリストのための予約・顧客管理";
const description =
  "予約、顧客カルテ、施術履歴、参考デザインと仕上がり写真を、お客様ごとにひとつに。個人ネイリストのためのiPhoneアプリ。";
const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "KiraKiran ネイル顧客管理",
  applicationCategory: "BusinessApplication",
  operatingSystem: "iOS",
  description,
  url: "https://ciaranfontein.com/kirakiran/",
  inLanguage: ["ja", "en"],
  image: "https://ciaranfontein.com/images/kirakiran/app-icon.webp",
};
---

<BaseLayout
  {title}
  {description}
  lang="ja"
  ogImage="/images/kirakiran/app-icon.webp"
  ogImageWidth={512}
  ogImageHeight={512}
  jsonLd={appJsonLd}
  skipLabel="本文へ移動"
  twitterCard="summary"
>
  <header class="site-header">
    <a class="brand" href="/kirakiran/" aria-label="KiraKiran ホーム">
      <img src="/images/kirakiran/app-icon.webp" width="42" height="42" alt="" />
      <span>KiraKiran</span>
    </a>
    <nav aria-label="ページ内ナビゲーション">
      <a href="#features">できること</a>
      <a href="#screens">画面を見る</a>
      <a class="nav-cta" href={BETA_URL}>ベータ版に参加</a>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">個人ネイリストのための予約・顧客管理</p>
        <h1 id="hero-title">予約も、カルテも、写真も。<br /><span>お客様ごとに、ひとつに。</span></h1>
        <p class="hero-lede">
          LINE、DM、メモに散らばりがちなサロンワークを、ひとつの見やすい場所へ。
          KiraKiranは、一人で働くネイリストの毎日に合わせて作られたiPhoneアプリです。
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={BETA_URL}>
            ベータ版に参加する
          </a>
          <a class="button button--quiet" href="#features">できることを見る</a>
        </div>
        <ul class="hero-proof" aria-label="KiraKiranの特徴">
          <li>日本語ファースト</li><li>英語表示にも対応</li><li>iPhone対応</li>
        </ul>
      </div>

      <div class="hero-stage" aria-label="KiraKiranのアプリ画面">
        <div class="orbit orbit--one" aria-hidden="true"></div>
        <div class="orbit orbit--two" aria-hidden="true"></div>
        <figure class="phone phone--back">
          <img src="/images/kirakiran/clients.webp" width="1320" height="2868" alt="お客様を名前やふりがなで探せる顧客一覧" />
        </figure>
        <figure class="phone phone--front">
          <img src="/images/kirakiran/appointment.webp" width="1320" height="2868" alt="お客様、日時、メニュー、料金、メモをまとめる予約登録画面" />
        </figure>
        <div class="hero-note hero-note--top">予約情報をまとめて入力</div>
        <div class="hero-note hero-note--bottom">ふりがなでも検索</div>
      </div>
    </section>

    <section class="signal" aria-label="KiraKiranでまとめて管理できるもの">
      <p>予約</p><span aria-hidden="true">✦</span><p>顧客カルテ</p><span aria-hidden="true">✦</span>
      <p>施術履歴</p><span aria-hidden="true">✦</span><p>デザイン写真</p>
    </section>

    <section class="problem">
      <div class="section-intro">
        <p class="kicker">A calmer way to run the day</p>
        <h2>探す時間を減らして、<br />目の前のお客様に集中。</h2>
      </div>
      <div class="problem-copy">
        <p>「次は何時？」「前回はどの色？」「あの参考画像はどこ？」を、チャットや写真フォルダを行き来せずに確認できます。</p>
        <p>予約とカルテと写真が同じお客様につながっているから、開いた瞬間に必要な文脈がそろいます。</p>
      </div>
    </section>

    <section id="features" class="features" aria-labelledby="features-title">
      <div class="section-intro section-intro--center">
        <p class="kicker">Built around real salon work</p>
        <h2 id="features-title">サロンワークの流れに、<br />そのまま馴染む。</h2>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-copy"><p class="feature-number">01</p><h3>予約を、抜けなくひとつに。</h3><p>お客様、日時、メニュー、料金、メモを同じ予約にまとめて、カレンダーからすぐ確認できます。</p></div>
          <img src="/images/kirakiran/appointment.webp" width="1320" height="2868" alt="KiraKiranの予約登録画面" loading="lazy" />
        </article>
        <article class="feature-card">
          <div class="feature-copy"><p class="feature-number">02</p><h3>お客様のことを、忘れない。</h3><p>名前やふりがなで検索。連絡先、メモ、アレルギーなどの大切な情報をカルテにまとめます。</p></div>
          <img src="/images/kirakiran/clients.webp" width="1320" height="2868" alt="KiraKiranの顧客一覧" loading="lazy" />
        </article>
        <article class="feature-card feature-card--photos">
          <div class="feature-copy"><p class="feature-number">03</p><h3>空き時間を、ひと目で確認。</h3><p>一週間の受付時間をまとめて設定。予約を受けられる時間と休みの日を、同じ画面で確認できます。</p></div>
          <img src="/images/kirakiran/availability.webp" width="1320" height="2868" alt="一週間の受付可能時間を設定するスケジュール管理画面" loading="lazy" />
        </article>
      </div>
    </section>

    <section class="workflow" aria-labelledby="workflow-title">
      <div class="section-intro"><p class="kicker">One continuous record</p><h2 id="workflow-title">予約の日から、<br />次のご来店まで。</h2></div>
      <ol class="steps">
        <li><span>01</span><div><h3>予約を入れる</h3><p>日時、メニュー、料金、お客様をひとつの予約に。</p></div></li>
        <li><span>02</span><div><h3>施術前に確認する</h3><p>カルテと参考デザインを見て、準備をスムーズに。</p></div></li>
        <li><span>03</span><div><h3>仕上がりを残す</h3><p>写真とメモを履歴に残し、次回の提案につなげる。</p></div></li>
      </ol>
    </section>

    <section id="screens" class="screens" aria-labelledby="screens-title">
      <div class="section-intro section-intro--center">
        <p class="kicker">The app, as it is</p><h2 id="screens-title">見やすく、迷わず、<br />毎日使える。</h2>
        <p class="section-lede">実際のKiraKiran画面です。日本語を中心に、必要な情報を必要な順番で表示します。</p>
      </div>
      <div class="screen-gallery">
        <figure><img src="/images/kirakiran/clients.webp" width="1320" height="2868" alt="顧客一覧画面" loading="lazy" /><figcaption>顧客一覧</figcaption></figure>
        <figure><img src="/images/kirakiran/appointment.webp" width="1320" height="2868" alt="予約登録画面" loading="lazy" /><figcaption>予約登録</figcaption></figure>
        <figure><img src="/images/kirakiran/availability.webp" width="1320" height="2868" alt="一週間の受付可能時間を設定するスケジュール管理画面" loading="lazy" /><figcaption>スケジュール管理</figcaption></figure>
      </div>
    </section>

    <section id="beta" class="beta" aria-labelledby="beta-title">
      <div class="beta-inner">
        <div class="beta-intro">
          <p class="kicker">Beta</p>
          <h2 id="beta-title">ベータ版に参加する</h2>
          <p>現在、個人サロンの皆さまと先行テスト中です。iPhoneで使えるテスト版にご招待します。</p>
        </div>
        <div class="beta-panel">
          <form id="beta-form" class="beta-form" novalidate data-beta-form>
            <div class="field">
              <label for="beta-salon">サロン名 <span class="req">必須</span></label>
              <input id="beta-salon" name="salon_name" type="text" maxlength="100" autocomplete="organization" required aria-describedby="beta-salon-error" />
              <p class="field-error" id="beta-salon-error" hidden></p>
            </div>
            <div class="field">
              <label for="beta-name">お名前 <span class="req">必須</span></label>
              <input id="beta-name" name="contact_name" type="text" maxlength="100" autocomplete="name" required aria-describedby="beta-name-error" />
              <p class="field-error" id="beta-name-error" hidden></p>
            </div>
            <div class="field">
              <label for="beta-email">メールアドレス <span class="req">必須</span></label>
              <input id="beta-email" name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" required aria-describedby="beta-email-error" />
              <p class="field-error" id="beta-email-error" hidden></p>
            </div>
            <div class="field">
              <label for="beta-type">サロンの種類 <span class="req">必須</span></label>
              <select id="beta-type" name="salon_type" required aria-describedby="beta-type-error">
                <option value="">選択してください</option>
                <option value="nail">ネイル</option>
                <option value="eyelash">まつげ</option>
                <option value="hair">ヘア</option>
                <option value="esthetic">エステ</option>
                <option value="other">その他</option>
              </select>
              <p class="field-error" id="beta-type-error" hidden></p>
            </div>
            <fieldset class="field" aria-describedby="beta-iphone-error">
              <legend>iPhoneをお使いですか <span class="req">必須</span></legend>
              <div class="choices">
                <label class="choice"><input type="radio" name="has_iphone" value="yes" required /> はい</label>
                <label class="choice"><input type="radio" name="has_iphone" value="no" /> いいえ</label>
              </div>
              <p class="field-error" id="beta-iphone-error" hidden></p>
            </fieldset>
            <div class="field">
              <label for="beta-heard">KiraKiranを知ったきっかけ <span class="opt">任意</span></label>
              <input id="beta-heard" name="heard_from" type="text" maxlength="200" aria-describedby="beta-heard-error" />
              <p class="field-error" id="beta-heard-error" hidden></p>
            </div>
            <div class="field">
              <label for="beta-message">ひとことメッセージ <span class="opt">任意</span></label>
              <textarea id="beta-message" name="message" rows="4" maxlength="1000" aria-describedby="beta-message-error"></textarea>
              <p class="field-error" id="beta-message-error" hidden></p>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="beta-website">Website</label>
              <input id="beta-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <p class="beta-privacy">入力いただいた情報は、ベータ版のご案内のみに使用します。<a href="/privacy/kirakiran/">プライバシーポリシー</a></p>
            <div class="form-error" id="beta-form-error" tabindex="-1" hidden>
              <p data-beta-error-text></p>
              <p>送信できない場合は<a href={BETA_FALLBACK_MAILTO}>メールでご連絡ください</a>。</p>
            </div>
            <button class="button button--primary beta-submit" type="submit" data-beta-submit>送信する</button>
          </form>
          <div class="beta-success" tabindex="-1" hidden data-beta-success>
            <p class="beta-success-title">お申し込みありがとうございます。数日以内にご連絡します。</p>
          </div>
          <p class="sr-only" role="status" aria-live="polite" data-beta-status></p>
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="cta-title">
      <img src="/images/kirakiran/app-icon.webp" width="120" height="120" alt="KiraKiranアプリアイコン" />
      <p class="kicker">KiraKiran for iPhone</p><h2 id="cta-title">サロンワークを、<br />もう少し軽やかに。</h2>
      <p>予約・カルテ・写真を、お客様ごとにひとつの場所へ。</p>
      <a class="button button--primary" href={BETA_URL}>ベータ版に参加する</a>
    </section>
  </main>

  <footer>
    <a class="footer-brand" href="/kirakiran/">KiraKiran</a>
    <div><a href="/privacy/kirakiran/">プライバシーポリシー</a><a href="/">開発者について</a></div>
    <p>© {new Date().getFullYear()} KiraKiran</p>
  </footer>
</BaseLayout>

<script is:inline define:vars={{ BETA_SIGNUP_ENDPOINT }}>
  (function () {
    var loadedAt = Date.now();
    var form = document.querySelector("[data-beta-form]");
    if (!form) return;
    var submit = form.querySelector("[data-beta-submit]");
    var success = document.querySelector("[data-beta-success]");
    var status = document.querySelector("[data-beta-status]");
    var formError = document.getElementById("beta-form-error");
    var formErrorText = formError.querySelector("[data-beta-error-text]");

    var fields = {
      salon_name: { el: form.elements.salon_name, err: "beta-salon-error" },
      contact_name: { el: form.elements.contact_name, err: "beta-name-error" },
      email: { el: form.elements.email, err: "beta-email-error" },
      salon_type: { el: form.elements.salon_type, err: "beta-type-error" },
      has_iphone: { el: form.querySelector('input[name="has_iphone"]'), err: "beta-iphone-error" },
      heard_from: { el: form.elements.heard_from, err: "beta-heard-error" },
      message: { el: form.elements.message, err: "beta-message-error" }
    };
    var order = ["salon_name", "contact_name", "email", "salon_type", "has_iphone", "heard_from", "message"];

    function setError(name, text) {
      var f = fields[name];
      var node = document.getElementById(f.err);
      node.textContent = text || "";
      node.hidden = !text;
      if (name === "has_iphone") {
        form.querySelectorAll('input[name="has_iphone"]').forEach(function (r) {
          if (text) r.setAttribute("aria-invalid", "true"); else r.removeAttribute("aria-invalid");
        });
      } else if (text) {
        f.el.setAttribute("aria-invalid", "true");
      } else {
        f.el.removeAttribute("aria-invalid");
      }
    }

    function read() {
      var iphone = form.querySelector('input[name="has_iphone"]:checked');
      return {
        salon_name: form.elements.salon_name.value.trim(),
        contact_name: form.elements.contact_name.value.trim(),
        email: form.elements.email.value.trim(),
        salon_type: form.elements.salon_type.value,
        has_iphone: iphone ? iphone.value === "yes" : null,
        heard_from: form.elements.heard_from.value.trim(),
        message: form.elements.message.value.trim()
      };
    }

    function validate(v) {
      var e = {};
      if (!v.salon_name) e.salon_name = "サロン名を入力してください。";
      else if (v.salon_name.length > 100) e.salon_name = "サロン名は100文字以内で入力してください。";
      if (!v.contact_name) e.contact_name = "お名前を入力してください。";
      else if (v.contact_name.length > 100) e.contact_name = "お名前は100文字以内で入力してください。";
      if (!v.email) e.email = "メールアドレスを入力してください。";
      else if (v.email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email)) e.email = "メールアドレスの形式をご確認ください。";
      if (!v.salon_type) e.salon_type = "サロンの種類を選択してください。";
      if (v.has_iphone === null) e.has_iphone = "「はい」か「いいえ」を選択してください。";
      if (v.heard_from.length > 200) e.heard_from = "200文字以内で入力してください。";
      if (v.message.length > 1000) e.message = "1000文字以内で入力してください。";
      return e;
    }

    function showFormError(text) {
      formErrorText.textContent = text;
      formError.hidden = false;
      formError.focus();
    }

    function setSending(sending) {
      submit.disabled = sending;
      submit.textContent = sending ? "送信中…" : "送信する";
      form.setAttribute("aria-busy", sending ? "true" : "false");
    }

    form.addEventListener("input", function (ev) {
      var name = ev.target && ev.target.name;
      if (name && fields[name]) setError(name, "");
    });

    form.addEventListener("submit", function (ev) {
      ev.preventDefault();
      if (submit.disabled) return;
      formError.hidden = true;
      var values = read();
      var errors = validate(values);
      order.forEach(function (name) { setError(name, errors[name]); });
      var firstBad = order.filter(function (name) { return errors[name]; })[0];
      if (firstBad) {
        status.textContent = "入力内容をご確認ください。";
        fields[firstBad].el.focus();
        return;
      }
      status.textContent = "送信中です。";
      setSending(true);
      var payload = {
        salon_name: values.salon_name,
        contact_name: values.contact_name,
        email: values.email,
        salon_type: values.salon_type,
        has_iphone: values.has_iphone,
        heard_from: values.heard_from || null,
        message: values.message || null,
        website: form.elements.website.value,
        elapsed_ms: Date.now() - loadedAt,
        locale: "ja"
      };
      var controller = new AbortController();
      var timer = setTimeout(function () { controller.abort(); }, 15000);
      fetch(BETA_SIGNUP_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
        signal: controller.signal
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (data) { return { status: res.status, data: data }; });
      }).then(function (r) {
        clearTimeout(timer);
        if (r.status === 200 && r.data && r.data.success === true) {
          form.hidden = true;
          success.hidden = false;
          status.textContent = "お申し込みを受け付けました。";
          success.focus();
          return;
        }
        setSending(false);
        var msg = r.status === 429
          ? "送信回数が上限に達しました。しばらくしてからもう一度お試しください。"
          : r.status === 400
            ? "入力内容をご確認のうえ、もう一度お試しください。"
            : "送信できませんでした。時間をおいてもう一度お試しください。";
        status.textContent = msg;
        showFormError(msg);
      }).catch(function () {
        clearTimeout(timer);
        setSending(false);
        var msg = "送信できませんでした。通信状況をご確認のうえ、もう一度お試しください。";
        status.textContent = msg;
        showFormError(msg);
      });
    });
  })();
</script>


<style>
  :global(html) { scroll-padding-top: 5rem; }
  :global(body) {
    --kk-ink: #241b20; --kk-muted: #6e6269; --kk-pink: #db6f8e; --kk-pink-strong: #a8335a;
    --kk-pink-soft: #f8e5eb; --kk-cream: #fffaf6; --kk-paper: #fffefd; --kk-line: #eadde2;
    background: var(--kk-cream); color: var(--kk-ink);
  }
  .site-header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.75rem; padding: .65rem clamp(1rem,4vw,4.5rem); background: color-mix(in srgb,var(--kk-cream) 92%,transparent); border-bottom: 1px solid color-mix(in srgb,var(--kk-line) 80%,transparent); backdrop-filter: blur(16px); }
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: var(--kk-ink); font-size: 1.05rem; font-weight: 800; letter-spacing: -.03em; text-decoration: none; }
  .brand img { border-radius: .65rem; box-shadow: 0 7px 18px rgb(105 55 72 / 12%); }
  nav { display: flex; align-items: center; gap: clamp(.75rem,2.2vw,2rem); }
  nav a { color: var(--kk-muted); font-size: .84rem; font-weight: 700; text-decoration: none; }
  nav a:hover, nav a:focus-visible { color: var(--kk-pink-strong); }
  .nav-cta { padding: .62rem 1rem; color: white; background: var(--kk-ink); border-radius: 999px; }
  nav .nav-cta:hover, nav .nav-cta:focus-visible { color: white; background: var(--kk-pink-strong); }
  .hero { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(20rem,.95fr); align-items: center; gap: clamp(3rem,8vw,8rem); min-height: calc(100svh - 4.75rem); max-width: 88rem; margin: 0 auto; padding: clamp(4rem,9vw,8rem) clamp(1.25rem,6vw,6rem); overflow: hidden; }
  .kicker { margin: 0 0 1rem; color: var(--kk-pink-strong); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 { max-width: 13ch; margin: 0; font-size: clamp(2.75rem,5.6vw,6rem); font-weight: 850; line-height: 1.03; letter-spacing: -.065em; }
  h1 span { color: var(--kk-pink-strong); }
